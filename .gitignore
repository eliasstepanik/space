# Rust
/target
**/target

# Copied toolchain (never commit)
/.sandbox-toolchain/

# Phase-0 spike builds
/spikes/*/target

# Render/validation artifacts (convention: artifacts/*.png)
artifacts/*.png

# Warren sandbox scratch (TMPDIR and the sandbox's Rust installation); the
# sandbox setup itself, .warren/sandbox.toml, is tracked
/.warren/tmp/
/.warren/rustup/

# Local GPU/Vulkan userspace prefix (never commit; ~64 MB of .debs extracted)
/.local/

# Local run artefacts: offline client renders and the orchestrator state file
/*.ppm
/*.glb
/space-orchestrator.id*
