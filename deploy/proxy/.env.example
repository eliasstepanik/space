# Copy to /home/proxy/stacks/space/.env (docker compose reads it from the compose file's directory).
SPACE_CLUSTER=space-prod

# Host ports (UDP for orchestrator/shard, TCP for the pixel-stream client).
ORCHESTRATOR_PORT=7900
SHARD_PORT=7870
CLIENT_PORT=8099

# Scene every shard runs until an operator picks another one in the web UI
# (demo-area, materials, solar, galaxy). INITIAL value only: a scene chosen at
# run time is saved in ./state and wins on restart.
SPACE_SCENE=demo-area

# Orchestrator web UI (status page; split / merge / scene controls). Off while
# SPACE_WEBUI_BIND is empty. To switch it on set BOTH lines -- a bind without a
# token makes the orchestrator refuse to start:
#   SPACE_WEBUI_BIND=0.0.0.0:7980
#   SPACE_WEBUI_TOKEN=<at least 16 random characters, e.g. from `openssl rand -hex 24`>
# The port is published on this host's loopback only (WEBUI_PORT). Open it with
#   ssh -L 7980:127.0.0.1:7980 <this host>     then http://127.0.0.1:7980/
# and log in with any user name and the token as the password.
SPACE_WEBUI_BIND=
SPACE_WEBUI_TOKEN=
WEBUI_PORT=7980

# Image tag to run: `latest` (what Watchtower follows), or pin to `sha-<shortsha>`
# to roll back (a pinned tag stops Watchtower from moving the container).
SPACE_TAG=latest
