# Copy to /home/proxy/stacks/space/.env (docker compose reads it from the compose file's directory).
SPACE_CLUSTER=space-prod

# REQUIRED. The cluster secret: what a shard must present to register with the
# orchestrator. At least 16 random characters, e.g. from `openssl rand -hex 24`.
# Without it `docker compose` refuses to start the stack and says why. The
# orchestrator hands it to the shard containers it starts (in their
# environment); nobody else needs it.
# (The orchestrator's control port, 7900/udp, is not published on this host: the
# shards reach it over the compose network. The secret is required all the
# same - the port is not on loopback inside the container.)
SPACE_CLUSTER_SECRET=

# REQUIRED. The group of the Docker socket on this host:
#   stat -c %g /var/run/docker.sock
# The orchestrator starts and stops its shard containers through that socket
# (mounted into its container); it does not run as root there and is given
# this group instead. NOTE: whoever can use the socket is root on this host -
# docs/security-notes.md, "The Docker socket".
DOCKER_GID=

# Host ports. PLAYER_PORT (UDP) is the one address players type. SPACE_SHARD_PORTS
# (UDP, a range) are the shards': each shard container publishes one of them,
# and a player is sent on to it - both must be open in the firewall. CLIENT_PORT
# (TCP) is the pixel-stream client's.
PLAYER_PORT=7777
SPACE_SHARD_PORTS=7870-7899
CLIENT_PORT=8099

# How many shards the orchestrator keeps running (4 = the demo area in four
# areas) and the most it scales out to under load.
SPACE_MIN_SHARDS=4
SPACE_MAX_SHARDS=8

# Scene every shard runs until an operator picks another one in the web UI
# (demo-area, materials, galaxy; the solar system is part of demo-area). INITIAL
# value only: a scene chosen at run time is saved in ./state and wins on restart.
SPACE_SCENE=demo-area

# Orchestrator web UI (status page; split / merge / scene controls). Off while
# SPACE_WEBUI_BIND is empty - and with the Docker socket mounted, leave it off
# unless you need it: it is the one way to operate the orchestrator from
# outside. To switch it on set BOTH lines -- a bind without a token makes the
# orchestrator refuse to start:
#   SPACE_WEBUI_BIND=0.0.0.0:7980
#   SPACE_WEBUI_TOKEN=<at least 16 random characters, e.g. from `openssl rand -hex 24`>
# The port is published on this host's loopback only (WEBUI_PORT). Open it with
#   ssh -L 7980:127.0.0.1:7980 <this host>     then http://127.0.0.1:7980/
# and log in with any user name and the token as the password.
SPACE_WEBUI_BIND=
SPACE_WEBUI_TOKEN=
WEBUI_PORT=7980

# Image tag to run: `latest` (what Watchtower follows), or pin to `sha-<shortsha>`
# to roll back (a pinned tag stops Watchtower from moving the container). The
# shards always follow the orchestrator: it starts them from the shard image of
# its own commit.
SPACE_TAG=latest
