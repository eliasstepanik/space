# Copy to /opt/space/.env (docker compose reads it from the compose file's directory).
SPACE_CLUSTER=space-prod

# Host ports (UDP for orchestrator/shard, TCP for the stream client).
ORCHESTRATOR_PORT=7900
SHARD_PORT=7871
STREAM_PORT=8099

# Image tag to run: `latest`, or pin to `sha-<shortsha>` to roll back.
SPACE_TAG=latest

# Uncomment to also run the ws:// pixel-stream client.
# COMPOSE_PROFILES=stream
