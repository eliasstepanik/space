# Space streaming-client image: builds `space-client` (release) and runs it in
# `--stream` mode: it renders headlessly (software Vulkan, lavapipe), JPEG-encodes
# each frame and serves it to browser viewers over plain ws://, optionally playing
# on a shard (`--server`).
#
# Build from the REPOSITORY ROOT (the workspace is the build context):
#   docker build -f deploy/Dockerfile.client -t space/client .
#
# Built and run locally (Docker 28 on Windows, through docker-compose.yaml):
# see "What is and is not verified" in deploy/README.md.
#
# The wasm viewer (crates/space-viewer) is NOT served by this image: the client's
# `--stream` port speaks WebSocket only. The viewer page is a local development
# tool: `cargo run -p xtask -- viewer` serves it, and `?ws=ws://<host>:<port>`
# points it at this container.

# ---- build stage ----------------------------------------------------------
FROM rust:1.100-bookworm AS build
WORKDIR /src
ENV RUSTUP_TOOLCHAIN=1.100.0
COPY . .
RUN cargo build --release --locked -p space-client --bin space-client

# ---- runtime stage --------------------------------------------------------
FROM debian:trixie-slim AS runtime
# The renderer loads libvulkan.so.1 at run time (ash `loaded`), so the image needs
# the loader plus an ICD. `mesa-vulkan-drivers` ships lavapipe (CPU Vulkan), which
# is what a GPU-less container uses.
# WHY trixie: the renderer always builds a BLAS, so RenderContext::new fails
# without VK_KHR_acceleration_structure. lavapipe only exposes it (plus
# deferred_host_operations, ray_query, ray_tracing_pipeline) from Mesa >= 24.1.
# bookworm's Mesa 22.3 lacks it ("llvmpipe ... lacks VK_KHR_acceleration_structure"
# and the proxy exits); trixie ships Mesa 25.0.x, verified to list all of them.
# The build stage stays on bookworm: the binary only needs an older glibc than
# trixie's, and the builder never runs Vulkan.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libvulkan1 mesa-vulkan-drivers \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 client
COPY --from=build /src/target/release/space-client /usr/local/bin/space-client
USER client

# STREAM_BIND  wildcard ws:// listen address inside the container (viewers dial it).
# SPACE_SERVER `host:port` of the shard to play on (`--server`; resolved, but
#              compose uses the fixed shard IP). When set, the client keeps
#              retrying until the shard answers, and again after every loss, and
#              logs each attempt to stderr. The client is online only: unset, it
#              sits on its connect screen until a viewer types an address.
# CLIENT_ARGS  optional extra flags, word-split, e.g. "--size 1280x720 --quality
#              medium". The scene is not a client flag: the shard announces it.
# No TLS: ws:// only (wss:// is deferred, see docs/security-notes.md).
ENV STREAM_BIND=0.0.0.0:8099
EXPOSE 8099/tcp

ENTRYPOINT ["/bin/sh", "-c", "exec space-client \
  --stream \"$STREAM_BIND\" \
  ${SPACE_SERVER:+--server \"$SPACE_SERVER\"} \
  $CLIENT_ARGS", "space-client"]
