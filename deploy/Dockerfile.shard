# Space shard image: builds `space-server` (release) and runs it as an
# orchestrated shard.
#
# Build from the REPOSITORY ROOT (the workspace is the build context):
#   docker build -f deploy/Dockerfile.shard -t space/shard .
#
# Built and run locally (Docker 28 on Windows, through docker-compose.yaml):
# see "What is and is not verified" in deploy/README.md.

# ---- build stage ----------------------------------------------------------
FROM rust:1.100-bookworm AS build
WORKDIR /src
# `rust-toolchain.toml` pins 1.100.0 *and* the wasm32 target; the image already
# has 1.100, so select it explicitly rather than have rustup fetch a target
# the server does not need.
ENV RUSTUP_TOOLCHAIN=1.100.0
COPY . .
# The two cache mounts keep cargo's downloads and the whole target directory in
# BuildKit's cache instead of in an image layer. `COPY . .` invalidates the
# layer on every commit, so without them every build compiles all dependencies
# again; with them only what changed is rebuilt. The three deploy images share
# one target cache (same profile, same flags; `sharing=locked` lets one build
# use it at a time). The binary is copied out because a cache mount is not part
# of the image. A builder without that cache just builds from scratch.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=space-target-release,target=/src/target,sharing=locked \
    cargo build --release --locked -p space-server --bin space-server \
 && cp target/release/space-server /usr/local/bin/space-server

# ---- runtime stage --------------------------------------------------------
FROM debian:bookworm-slim AS runtime
RUN useradd --create-home --uid 10001 shard
COPY --from=build /usr/local/bin/space-server /usr/local/bin/space-server
USER shard

# QUIC is UDP. Bind the wildcard so the container's published port is reachable;
# the address peers/clients should DIAL is passed as SHARD_ADVERTISE.
ENV SHARD_BIND=0.0.0.0:7870 \
    SPACE_CLUSTER=space-local
EXPOSE 7870/udp

# The orchestrator's control address (ORCHESTRATOR_ADDR) and the advertised
# address (SHARD_ADVERTISE) are required, as `ip:port` (they are parsed as socket
# addresses, not resolved as host names). An optional SHARD_CLAIM_REGION
# (`depth:x:y:z`) is added by the shell below when set. The id and region come
# from the orchestrator's welcome: no `--shard` here (H9).
ENTRYPOINT ["/bin/sh", "-c", "exec space-server \
  --orchestrator \"${ORCHESTRATOR_ADDR:?set ORCHESTRATOR_ADDR=ip:port}\" \
  --cluster \"$SPACE_CLUSTER\" \
  --bind \"$SHARD_BIND\" \
  --advertise \"${SHARD_ADVERTISE:?set SHARD_ADVERTISE=ip:port}\" \
  ${SHARD_CLAIM_REGION:+--claim-region \"$SHARD_CLAIM_REGION\"}", "space-shard"]
