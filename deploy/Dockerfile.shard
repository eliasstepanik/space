# Space shard image: builds `space-server` (release) and runs it as an
# orchestrated shard.
#
# Build from the REPOSITORY ROOT (the workspace is the build context):
#   docker build -f deploy/Dockerfile.shard -t space/shard .
#
# Nobody starts this image by hand in the shipped stacks: the orchestrator does,
# one container per shard (`--launcher docker`), with its own command line -
# `space-server --orchestrator <control address> --cluster <id> --bind 0.0.0.0:<P>
# --advertise 0.0.0.0:<P> --client-endpoint 0.0.0.0:<P>`, the cluster secret in
# the environment - so the binary must stay on the PATH under this name. The
# entrypoint below is for a shard started by hand next to an orchestrator.
#
# What was built and run where: "What is and is not verified" in deploy/README.md.

# ---- build stage ----------------------------------------------------------
FROM rust:1.100-bookworm AS build
WORKDIR /src
# `rust-toolchain.toml` pins 1.100.0 *and* the wasm32 target; the image already
# has 1.100, so select it explicitly rather than have rustup fetch a target
# the server does not need.
ENV RUSTUP_TOOLCHAIN=1.100.0
COPY . .
RUN cargo build --release --locked -p space-server --bin space-server

# ---- runtime stage --------------------------------------------------------
FROM debian:bookworm-slim AS runtime
RUN useradd --create-home --uid 10001 shard
COPY --from=build /src/target/release/space-server /usr/local/bin/space-server
USER shard

# QUIC is UDP. Bind the wildcard so the container's published port is reachable.
ENV SHARD_BIND=0.0.0.0:7870 \
    SHARD_ADVERTISE=0.0.0.0:7870 \
    SPACE_CLUSTER=space-local
EXPOSE 7870/udp

# By hand: the orchestrator's control address (ORCHESTRATOR_ADDR, `ip:port` or
# `name:port`) is required. SHARD_ADVERTISE is the address other shards dial
# (`0.0.0.0:<port>`, the default: the orchestrator fills in the address it sees
# this container at); SHARD_CLIENT_ENDPOINT, when set, is where players dial it
# (`0.0.0.0:<host port>` = the host they dialed the player port on). An optional
# SHARD_CLAIM_REGION (`depth:x:y:z`) is added when set. The id and the region
# come from the orchestrator's welcome: no `--shard` here (H9). The cluster
# secret is read by the binary from SPACE_CLUSTER_SECRET.
ENTRYPOINT ["/bin/sh", "-c", "exec space-server \
  --orchestrator \"${ORCHESTRATOR_ADDR:?set ORCHESTRATOR_ADDR=host:port}\" \
  --cluster \"$SPACE_CLUSTER\" \
  --bind \"$SHARD_BIND\" \
  --advertise \"$SHARD_ADVERTISE\" \
  ${SHARD_CLIENT_ENDPOINT:+--client-endpoint \"$SHARD_CLIENT_ENDPOINT\"} \
  ${SHARD_CLAIM_REGION:+--claim-region \"$SHARD_CLAIM_REGION\"}", "space-shard"]
