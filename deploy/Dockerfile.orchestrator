# Space orchestrator image: builds `space-orchestrator` (release).
#
# Build from the REPOSITORY ROOT (the workspace is the build context):
#   docker build -f deploy/Dockerfile.orchestrator -t space/orchestrator .
#
# Built and run locally (Docker 28 on Windows, through docker-compose.yaml):
# see "What is and is not verified" in deploy/README.md.
#
# The `--launcher docker` mode is DEFERRED (bollard is not in the offline cargo
# cache; see launcher/docker.rs), so this image runs `--launcher local`: shards
# are separate containers that register themselves (see docker-compose.yaml).

# ---- build stage ----------------------------------------------------------
FROM rust:1.100-bookworm AS build
WORKDIR /src
ENV RUSTUP_TOOLCHAIN=1.100.0
COPY . .
# The two cache mounts keep cargo's downloads and the whole target directory in
# BuildKit's cache instead of in an image layer. `COPY . .` invalidates the
# layer on every commit, so without them every build compiles all dependencies
# again; with them only what changed is rebuilt. The three deploy images share
# one target cache (same profile, same flags; `sharing=locked` lets one build
# use it at a time). The binary is copied out because a cache mount is not part
# of the image. A builder without that cache just builds from scratch.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=space-target-release,target=/src/target,sharing=locked \
    cargo build --release --locked -p space-orchestrator --bin space-orchestrator \
 && cp target/release/space-orchestrator /usr/local/bin/space-orchestrator

# ---- runtime stage --------------------------------------------------------
FROM debian:bookworm-slim AS runtime
RUN useradd --create-home --uid 10001 orchestrator \
 && mkdir -p /var/lib/space && chown orchestrator /var/lib/space
COPY --from=build /usr/local/bin/space-orchestrator /usr/local/bin/space-orchestrator
USER orchestrator

# The control port is QUIC (UDP). It binds the wildcard inside the container;
# ORCHESTRATOR_CONTROL_ADDR is the `ip:port` shards dial (not resolved as a name).
# The shard-id counter lives on a volume so a restart resumes above the last id
# (H9); the scene an operator chose is kept next to it (`orchestrator.id.scene`).
#
# Read by the binary itself (no flag in the entrypoint below):
#   SPACE_ORCHESTRATOR_SCENE         initial scene (demo-area, materials,
#                                    galaxy); a saved choice on the volume wins
#   SPACE_ORCHESTRATOR_WEBUI         `ip:port` of the operator web UI; unset or
#                                    empty = off. In a container it must be the
#                                    wildcard (0.0.0.0:7980), and then
#   SPACE_ORCHESTRATOR_WEBUI_TOKEN   (or ..._TOKEN_FILE) is REQUIRED, at least 16
#                                    characters: the orchestrator refuses to
#                                    start with a non-loopback bind and no token.
#   SPACE_ORCHESTRATOR_WEBUI_HOSTS   extra Host names (`name[:port]`, comma
#                                    separated) when a TLS proxy is in front.
# Plain HTTP, HTTP Basic auth (any user name, the token as password): publish the
# port on loopback or to a TLS proxy only. See docs/security-notes.md.
ENV ORCHESTRATOR_BIND=0.0.0.0:7900 \
    SPACE_CLUSTER=space-local
VOLUME /var/lib/space
EXPOSE 7900/udp
EXPOSE 7980/tcp

ENTRYPOINT ["/bin/sh", "-c", "exec space-orchestrator \
  --bind \"$ORCHESTRATOR_BIND\" \
  --control-addr \"${ORCHESTRATOR_CONTROL_ADDR:?set ORCHESTRATOR_CONTROL_ADDR=ip:port}\" \
  --cluster \"$SPACE_CLUSTER\" \
  --state /var/lib/space/orchestrator.id \
  --launcher local", "space-orchestrator"]
